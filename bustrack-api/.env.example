NODE_ENV=development
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h

# MongoDB must run as a replica set so booking transactions work (see README)
MONGODB_URI=mongodb://127.0.0.1:27017/bustrack_india?replicaSet=rs0&directConnection=true

CORS_ORIGIN=http://localhost:8081,http://localhost:19006

MQTT_ENABLED=false
MQTT_BROKER_URL=mqtts://your-private-broker:8883
MQTT_USERNAME=replace-with-broker-username
MQTT_PASSWORD=replace-with-broker-password
MQTT_TOPIC=bustrack/bus/+/location

GPS_SIMULATOR_ENABLED=false
GPS_SIMULATOR_INTERVAL_MS=5000

LOCATION_STALE_SECONDS=90
LOCATION_RETENTION_DAYS=7
